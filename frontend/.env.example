# Copy to .env.local for local development.
# Base URL of the backend API, including /api/v1 and no trailing slash. It is inlined at build time,
# so on Vercel set it BEFORE building (changing it later needs a redeploy). Production builds fail
# if it is missing; in development it falls back to the value below.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
