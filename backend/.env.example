# Copy to .env for local development. Never commit .env. On a host, set these in its dashboard.

# development | test | production. "production" hides error details in 500 responses.
ENV=development

# Python log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# SQLAlchemy URL (required). Relative path for local dev; absolute path for a persistent disk
# (four slashes = absolute), e.g. sqlite:////var/data/fireflies.db. Missing parent folders are created.
DATABASE_URL=sqlite:///./fireflies.db

# Browser origins allowed to call the API (required). JSON list, no trailing slashes.
# Production example: ["https://your-app.vercel.app"]
CORS_ORIGINS=["http://localhost:3000"]

# Optional regex for origins that change per deploy, e.g. Vercel preview URLs. Matched against the
# whole origin. Leave empty to allow only CORS_ORIGINS. Example:
# CORS_ORIGIN_REGEX=https://your-app-.*\.vercel\.app
CORS_ORIGIN_REGEX=

# true = on boot, insert the demo meetings if the database has none. Does nothing on a populated DB.
SEED_ON_STARTUP=true

# Optional: real AI summaries. Leave LLM_API_KEY empty to use the deterministic mock generator.
# This is a secret: set it only in your host's dashboard.
LLM_API_KEY=
# Base URL of any OpenAI-compatible API (default: xAI Grok).
LLM_BASE_URL=https://api.x.ai/v1
# Model name sent to that API.
LLM_MODEL=grok-4
